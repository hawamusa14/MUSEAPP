generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WeightUnit {
  LB
  KG
}

enum HeightUnit {
  IN
  CM
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum WorkoutStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MuscleGroup {
  UPPER_BODY
  LOWER_BODY
  CHEST
  BACK
  SHOULDERS
  ARMS
  BICEPS
  TRICEPS
  FOREARMS
  GLUTES
  QUADS
  HAMSTRINGS
  CALVES
  CORE
  FULL_BODY
  CARDIO
  MOBILITY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum GoalType {
  WEIGHT
  STRENGTH
  STEPS
  WORKOUT_FREQUENCY
  PROTEIN
  CALORIES
  CUSTOM
}

enum FitnessGoalKind {
  FAT_LOSS
  WEIGHT_LOSS
  MAINTENANCE
  MUSCLE_GAIN
  RECOMPOSITION
  STRENGTH
  ENDURANCE
}

enum Sex {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PhotoAngle {
  FRONT
  SIDE
  BACK
  CUSTOM
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum FitnessExperience {
  NEW
  RETURNING
  INTERMEDIATE
  ADVANCED
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ExerciseType {
  STRENGTH
  CARDIO
  MOBILITY
  STRETCH
  OTHER
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CardioIntensity {
  EASY
  MODERATE
  HARD
  MAX
}

enum PersonalRecordType {
  HEAVIEST_WEIGHT
  MOST_REPS
  HIGHEST_VOLUME
  ESTIMATED_1RM
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  name        String
  email       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile          UserProfile?
  settings         UserSettings?
  workouts         Workout[]
  customExercises  Exercise[]
  nutritionEntries NutritionEntry[]
  dailyNutrition   DailyNutrition[]
  cardioSessions   CardioSession[]
  stepEntries      StepEntry[]
  weightEntries    WeightEntry[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]
  journalEntries   JournalEntry[]
  personalRecords  PersonalRecord[]
  fitnessGoals     FitnessGoal[]
  plannedWorkouts  PlannedWorkout[]
  workoutTemplates WorkoutTemplate[]
  workoutSchedules WorkoutSchedule[]
}

model UserProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm              Float?
  dateOfBirth           DateTime?
  sex                   Sex?
  activityLevel         ActivityLevel?
  experience            FitnessExperience?
  primaryGoalKind       FitnessGoalKind?
  targetWeight          Float?
  trainingFrequency     Int?
  preferredDurationMin  Int?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model UserSettings {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightUnit      WeightUnit      @default(LB)
  heightUnit      HeightUnit      @default(IN)
  theme           ThemePreference @default(LIGHT)
  calorieTarget   Int?
  proteinTarget   Int?
  carbsTarget     Int?
  fatTarget       Int?
  fiberTarget     Int?
  waterTargetMl   Int?
  stepGoal        Int             @default(8000)
  notificationsOn Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ExerciseCategory {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  muscleGroup MuscleGroup
  exercises   Exercise[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Exercise {
  id          String           @id @default(cuid())
  name        String
  slug        String
  description String?
  equipment   String?
  categoryId  String
  category    ExerciseCategory @relation(fields: [categoryId], references: [id])
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  isCustom    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workoutExercises  WorkoutExercise[]
  personalRecords   PersonalRecord[]
  fitnessGoals      FitnessGoal[]
  plannedExercises  PlannedWorkoutExercise[]
  templateExercises WorkoutTemplateExercise[]
  secondaryMuscles  MuscleGroup[]
  exerciseType      ExerciseType?
  instructions      String?
  difficulty        ExerciseDifficulty?

  @@index([userId])
  @@index([categoryId])
  @@index([name])
  @@index([slug])
}

model Workout {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  date            DateTime      @db.Date
  status          WorkoutStatus @default(IN_PROGRESS)
  muscleGroups    MuscleGroup[]
  notes           String?
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  pausedAt        DateTime?
  pausedMs        Int           @default(0)
  durationSeconds Int?
  calories        Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  plannedWorkoutId String?         @unique
  plannedWorkout   PlannedWorkout? @relation(fields: [plannedWorkoutId], references: [id])
  exercises        WorkoutExercise[]
  journalEntries   JournalEntry[]
  personalRecords  PersonalRecord[]

  @@index([userId, date])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([plannedWorkoutId])
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  order      Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sets WorkoutSet[]

  @@index([workoutId, order])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  order             Int
  weight            Float?
  reps              Int?
  rpe               Float?
  restSeconds       Int?
  notes             String?
  completed         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workoutExerciseId, order])
}

model PersonalRecord {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise           @relation(fields: [exerciseId], references: [id])
  type       PersonalRecordType
  value      Float
  weight     Float?
  reps       Int?
  workoutId  String?
  workout    Workout?           @relation(fields: [workoutId], references: [id])
  notes      String?
  achievedAt DateTime           @default(now())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([userId, exerciseId, type])
  @@index([userId, achievedAt])
  @@index([workoutId])
}

model FitnessGoal {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        GoalType
  kind        FitnessGoalKind?
  title       String
  startValue  Float?
  targetValue Float?
  unit        String?
  targetDate  DateTime?
  exerciseId  String?
  exercise    Exercise?        @relation(fields: [exerciseId], references: [id])
  isPrimary   Boolean          @default(false)
  status      GoalStatus       @default(ACTIVE)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, type])
  @@index([userId, status])
}

model NutritionEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  time        DateTime?
  mealType    MealType
  foodName    String
  servingSize String?
  servings    Float     @default(1)
  calories    Float
  protein     Float     @default(0)
  carbs       Float     @default(0)
  fat         Float     @default(0)
  fiber       Float     @default(0)
  sugar       Float     @default(0)
  sodium      Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, date])
}

model DailyNutrition {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  calories  Float    @default(0)
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  fiber     Float    @default(0)
  sugar     Float    @default(0)
  sodium    Float    @default(0)
  waterMl        Float    @default(0)
  calorieTarget  Float?
  proteinTarget  Float?
  carbsTarget    Float?
  fatTarget      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model CardioSession {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  type        String
  durationMin Float
  distanceKm  Float?
  pace        String?
  calories    Int?
  heartRate   Int?
  intensity   CardioIntensity?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, date])
}

model StepEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  steps      Int
  distanceKm Float?
  calories   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model WeightEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  weight    Float
  unit      WeightUnit @default(LB)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, date])
}

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  name      String
  value     Float
  unit      String   @default("in")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, name])
}

model ProgressPhoto {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  angle      PhotoAngle
  label      String?
  notes      String?
  url        String
  storageKey String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, date])
}

model JournalEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  entry        String
  energy       Int?
  motivation   Int?
  recovery     Int?
  stress       Int?
  sleep        Int?
  hunger       Int?
  workoutNotes String?
  workoutId    String?
  workout      Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, date])
  @@index([workoutId])
}


enum PlanKind {
  STRENGTH
  CARDIO
  ACTIVE_RECOVERY
  MOBILITY
  REST
  CHECK_IN
  CUSTOM
}

enum PlanStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum RecurrenceInterval {
  WEEKLY
  BIWEEKLY
  CUSTOM
}

model PlannedWorkout {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  date          DateTime     @db.Date
  startTime     String?
  endTime       String?
  kind          PlanKind     @default(STRENGTH)
  muscleGroups  MuscleGroup[]
  notes         String?
  stepGoal      Int?
  cardioMinutes Float?
  status        PlanStatus   @default(PLANNED)
  templateId    String?
  template      WorkoutTemplate? @relation(fields: [templateId], references: [id])
  scheduleId    String?
  schedule      WorkoutSchedule? @relation(fields: [scheduleId], references: [id])
  workout       Workout?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  exercises     PlannedWorkoutExercise[]

  @@index([userId, date])
  @@index([userId, status])
  @@index([templateId])
  @@index([scheduleId])
}

model PlannedWorkoutExercise {
  id               String         @id @default(cuid())
  plannedWorkoutId String
  plannedWorkout   PlannedWorkout @relation(fields: [plannedWorkoutId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id])
  order            Int
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sets             PlannedWorkoutSet[]

  @@index([plannedWorkoutId, order])
  @@index([exerciseId])
}

model PlannedWorkoutSet {
  id                       String                 @id @default(cuid())
  plannedWorkoutExerciseId String
  plannedWorkoutExercise   PlannedWorkoutExercise @relation(fields: [plannedWorkoutExerciseId], references: [id], onDelete: Cascade)
  order                    Int
  targetWeight             Float?
  targetReps               Int?
  restSeconds              Int?
  notes                    String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([plannedWorkoutExerciseId, order])
}

model WorkoutTemplate {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  kind         PlanKind       @default(STRENGTH)
  muscleGroups MuscleGroup[]
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  exercises    WorkoutTemplateExercise[]
  plans        PlannedWorkout[]
  schedules    WorkoutSchedule[]
}

model WorkoutTemplateExercise {
  id           String          @id @default(cuid())
  templateId   String
  template     WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise        @relation(fields: [exerciseId], references: [id])
  order        Int
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sets         WorkoutTemplateSet[]

  @@index([templateId, order])
  @@index([exerciseId])
}

model WorkoutTemplateSet {
  id                       String                  @id @default(cuid())
  workoutTemplateExerciseId String
  workoutTemplateExercise   WorkoutTemplateExercise @relation(fields: [workoutTemplateExerciseId], references: [id], onDelete: Cascade)
  order                    Int
  targetWeight             Float?
  targetReps               Int?
  restSeconds              Int?

  @@index([workoutTemplateExerciseId, order])
}

model WorkoutSchedule {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  weekday       Int
  interval      RecurrenceInterval @default(WEEKLY)
  intervalWeeks Int                @default(1)
  kind          PlanKind           @default(STRENGTH)
  muscleGroups  MuscleGroup[]
  startTime     String?
  endTime       String?
  startsOn      DateTime?          @db.Date
  endsOn        DateTime?          @db.Date
  templateId    String?
  template      WorkoutTemplate?   @relation(fields: [templateId], references: [id])
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  instances     PlannedWorkout[]

  @@index([userId, weekday])
  @@index([userId, isActive])
}
